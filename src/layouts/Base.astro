---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
// docs/02 §4, docs/06 §4, docs/07 §6.
import ShLegalGate from '../components/islands/ShLegalGate.svelte';
import ShHeader from '../components/ShHeader.astro';
import ShFooter from '../components/ShFooter.astro';
import { localePair, localePath, t, type Locale } from '../i18n';
import { canonicalPath } from '../lib/locale';
// Pre-paint scripts, emitted verbatim as content-hashed /_astro/ files.
// `no-inline` is load-bearing: plain `?url` inlines files under 4 KiB as data:
// URLs, which `script-src 'self'` refuses (scripts/check-assets.mjs guards it).
import errorsUrl from '../scripts/errors.js?url&no-inline';
import themeUrl from '../scripts/theme.js?url&no-inline';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Reachable but meaningless in SERPs — /offline, /errors/* (docs/16 §7). */
  noindex?: boolean;
  /**
   * Pages the legal gate must never cover (docs/14 Part 2): the legal
   * documents it links to, and error/offline pages, which would otherwise
   * dead-lock. Declared by the PAGE, because Workers serves 404.html and the
   * service worker serves the offline page at whatever URL was requested — a
   * path rule can never recognise them.
   */
  gateExempt?: boolean;
}
const { title, description, locale = 'en', noindex = false, gateExempt = false } = Astro.props;

const site = Astro.site ?? new URL('https://softharbor.net');
// canonicalPath, never Astro.url.pathname directly: with build.format 'file'
// the latter is the emitted FILE name (/apps.html), which would make every
// canonical disagree with the sitemap and with the URL actually served.
const pair = localePair(Astro.url.pathname);
const canonical = new URL(canonicalPath(Astro.url.pathname), site);
const desc = description ?? t(locale, 'site.tagline');

// Resolved server-side for the page's locale only: importing the dictionaries
// into the island would bundle every key (docs/07 §3).
const gateStrings = {
  title: t(locale, 'gate.title'),
  body: t(locale, 'gate.body'),
  accept: t(locale, 'gate.accept'),
  disclaimer: t(locale, 'gate.link.disclaimer'),
  terms: t(locale, 'gate.link.terms'),
  privacy: t(locale, 'gate.link.privacy'),
  and: t(locale, 'gate.and'),
  base: localePath(locale, '/legal'),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}

    {/* Canonical is self-per-locale; alternates come from the single
        localePair() source the switcher will also use (docs/07 §5/§6). */}
    <link rel="alternate" hreflang="en" href={new URL(pair.en, site).href} />
    <link rel="alternate" hreflang="vi" href={new URL(pair.vi, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(pair.en, site).href} />

    <meta property="og:site_name" content={t(locale, 'site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'vi' ? 'en_GB' : 'vi_VN'} />
    <meta name="twitter:card" content="summary" />

    {/*
      Console ring buffer FIRST (docs/05 §A5): it must already be listening when
      theme.js or an island bootstrap throws. Blocking and tiny on purpose.
    */}
    <script is:inline src={errorsUrl}></script>
    {/* No-flash theme, blocking, before first paint — docs/05 §A8. */}
    <script is:inline src={themeUrl}></script>
    {/*
      Service-worker registration. @vite-pwa/astro EMITS /registerSW.js and
      /sw.js but never references them from any page — the build reports
      success while the SW silently never registers, so the offline fallback
      would not exist in production (found in spike S5). We load the emitted
      file ourselves. External, not inline, to satisfy script-src (docs/09 §4).
    */}
    <script is:inline defer src="/registerSW.js"></script>
  </head>
  <body class="flex min-h-dvh flex-col">
    {/*
      client:load — must block interaction immediately, not on idle. Every
      page is a full document load now (no <ClientRouter />), so each page
      mounts its own gate; there is nothing to persist across navigations.
    */}
    {!gateExempt && <ShLegalGate client:load strings={gateStrings} />}

    <a href="#main" class="sh-skip">
      {t(locale, 'nav.skipToContent')}
    </a>
    <ShHeader {locale} />

    <main id="main" class="mx-auto w-full max-w-[1360px] flex-1 px-4 py-8 md:px-6">
      <slot />
    </main>

    <ShFooter {locale} />
  </body>
</html>
