---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
// docs/02 §4, docs/06 §4, docs/07 §6.
import { ClientRouter } from 'astro:transitions';
import ShLegalGate from '../components/islands/ShLegalGate.svelte';
import ShHeader from '../components/ShHeader.astro';
import ShFooter from '../components/ShFooter.astro';
import { LOCALES, localePair, localePath, t, type Locale } from '../i18n';
import { canonicalPath } from '../lib/locale';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Reachable but meaningless in SERPs — /offline, /errors/* (docs/16 §7). */
  noindex?: boolean;
}
const { title, description, locale = 'en', noindex = false } = Astro.props;

const site = Astro.site ?? new URL('https://softharbor.net');
// canonicalPath, never Astro.url.pathname directly: with build.format 'file'
// the latter is the emitted FILE name (/apps.html), which would make every
// canonical disagree with the sitemap and with the URL actually served.
const pair = localePair(Astro.url.pathname);
const canonical = new URL(canonicalPath(Astro.url.pathname), site);
const desc = description ?? t(locale, 'site.tagline');

// Both locales resolved here, server-side: the gate is persisted across
// navigations and must switch language without a reload, but importing the
// dictionaries into the island would bundle every key (docs/07 §3).
const gateStrings = Object.fromEntries(
  LOCALES.map((l) => [
    l,
    {
      title: t(l, 'gate.title'),
      body: t(l, 'gate.body'),
      accept: t(l, 'gate.accept'),
      disclaimer: t(l, 'gate.link.disclaimer'),
      terms: t(l, 'gate.link.terms'),
      privacy: t(l, 'gate.link.privacy'),
      base: localePath(l, '/legal'),
    },
  ]),
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}

    {
      /* Canonical is self-per-locale; alternates come from the single
        localePair() source the switcher will also use (docs/07 §5/§6). */
    }
    <link rel="alternate" hreflang="en" href={new URL(pair.en, site).href} />
    <link rel="alternate" hreflang="vi" href={new URL(pair.vi, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(pair.en, site).href} />

    <meta property="og:site_name" content={t(locale, 'site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'vi' ? 'en_GB' : 'vi_VN'} />
    <meta name="twitter:card" content="summary" />

    {/* Blocking, same-origin, NOT inline — docs/05 §A8, docs/09 §4 (D20). */}
    <script is:inline src="/theme.js"></script>

    {
      /*
      Service-worker registration. @vite-pwa/astro EMITS /registerSW.js and
      /sw.js but never references them from any page — the build reports
      success while the SW silently never registers, so the offline fallback
      would not exist in production (found in spike S5). We load the emitted
      file ourselves. External, not inline, to satisfy script-src (docs/09 §4).
    */
    }
    <script is:inline defer src="/registerSW.js"></script>

    {
      /*
      Console ring buffer (docs/05 §A5). Loaded here rather than inside
      ShBugReport because that island is client:visible in the footer — a
      listener attached at hydration would miss every error that happened
      before the user scrolled, which is most of them.
    */
    }
    <script is:inline defer src="/errors.js"></script>

    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    {
      /*
      client:load — must block interaction immediately, not on idle.
      transition:persist — survives ClientRouter navigations so acceptance
      never re-flashes; it re-asserts modal state after each swap
      (docs/02 §5, docs/14 Part 2, spike S4).
    */
    }
    <ShLegalGate client:load transition:persist {locale} strings={gateStrings} />

    <a href="#main" class="sh-skip">{t(locale, 'nav.skipToContent')}</a>
    <ShHeader {locale} />

    <main id="main" class="mx-auto w-full max-w-[1360px] flex-1 px-4 py-8 md:px-6">
      <slot />
    </main>

    <ShFooter {locale} />
  </body>
</html>
