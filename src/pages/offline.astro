---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
// docs/06 §5, docs/08 Part D — service-worker navigation fallback.
// Bilingual on one page: when this renders the user has no network, so we
// cannot send them to a locale variant. noindex — reachable but meaningless
// in SERPs (docs/16 §7).
import Base from '../layouts/Base.astro';
---

<Base title="Offline — SoftHarbor" locale="en" noindex>
  <div class="relative">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-8 -left-2 font-mono text-[8rem] leading-none opacity-40 select-none"
      style="color: var(--sh-muted)">offline</span
    >
    <div class="relative">
      <h1 class="text-[length:var(--text-h1)] font-semibold">You appear to be offline</h1>
      <p class="mt-3 max-w-xl" style="color: var(--sh-muted)">
        SoftHarbor needs a connection to load new pages.
      </p>
      <p class="mt-6 max-w-xl" lang="vi" style="color: var(--sh-muted)">
        Bạn đang ngoại tuyến — SoftHarbor cần kết nối mạng để tải trang mới.
      </p>
      <p class="mt-8">
        <a href="/" class="underline" style="color: var(--sh-accent)">SoftHarbor</a>
      </p>
    </div>
  </div>
</Base>
