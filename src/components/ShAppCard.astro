---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
// docs/06 §6 — card anatomy: logo tile, name and developer, the price in its
// own colour, licence and platforms, two lines of summary, then the dated
// status and the categories along a ruled foot.
import { getCollection, type CollectionEntry } from 'astro:content';
import ShIcon from './ShIcon.astro';
import { logoSvg } from '../lib/logo';
import { localePath, t, type Locale } from '../i18n';

interface Props {
  app: CollectionEntry<'apps'>;
  locale: Locale;
  /**
   * Card titles sit directly under the page's h1 on /apps and category pages
   * (h2); a card listed inside an h2 section uses 3. Hard-coded h3 used to skip
   * a level on every grid page.
   */
  headingLevel?: 2 | 3;
}
const { app, locale, headingLevel = 2 } = Astro.props;
const d = app.data;
const Heading = headingLevel === 3 ? 'h3' : 'h2';

// Chips show the category's NAME in the page's language (they used to print
// the raw id, e.g. "security-privacy", on Vietnamese pages too). Astro caches
// getCollection per build, so this is not a query per card.
const categoryLabels = new Map(
  (await getCollection('categories')).map((c) => [c.id, c.data.label[locale]]),
);

const dateFmt = new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  dateStyle: 'medium',
  timeZone: 'UTC',
});
const fmt = (iso: string) => dateFmt.format(new Date(`${iso}T00:00:00Z`));

// Each string renders the date field it actually NAMES — the dated-honesty
// claim is the product (hard rule 4, docs/06 §6).
const clean = d.security.status === 'clean';
const security = clean
  ? `${t(locale, 'card.security.clean')} · ${t(locale, 'card.checked', { date: fmt(d.security.checkedAt) })}`
  : `${t(locale, 'card.security.unverified')} · ${t(locale, 'card.listed', { date: fmt(d.addedAt) })}`;

/** Free reads green, free-with-a-paid-tier blue, buy-once amber. */
const priceTone = {
  free: 'sh-tone-ok',
  'free-onetime': 'sh-tone-accent',
  onetime: 'sh-tone-warn',
}[d.pricing];
---

<!--
  Stretched-link pattern, NOT a wrapping <a> (docs/06 §6): an <a> inside an <a>
  is invalid HTML — the parser closes the outer one, silently breaking the card
  link and the a11y tree. The title is the only link to the detail page and its
  ::after covers the card; the category chips are ordinary siblings above it.

  The data-* attributes are the ONLY source the filter island reads (docs/05
  §A3), so filtering and sorting work before /search-index.json has loaded and
  keep working if search is never used.
-->
<article
  class="sh-panel sh-lift sh-anim sh-card relative flex flex-col gap-3 p-5"
  data-slug={app.id}
  data-categories={d.categories.map((c) => c.id).join(' ')}
  data-platforms={d.platforms.join(' ')}
  data-pricing={d.pricing}
  data-added={d.addedAt}
  data-name={d.name}
>
  <div class="flex items-start gap-3">
    <span class="sh-tile size-12">
      {/* Build-time SVG from a vendored icon set, a vendored asset, or a
          generated monogram — never user input. The set:html carve-out is
          scoped to this file in eslint.config.js. */}
      <Fragment
        set:html={logoSvg(d.logo, d.name, {
          class: 'size-7 sh-pop',
          'aria-hidden': 'true',
          fill: 'currentColor',
        })}
      />
    </span>
    <div class="min-w-0 flex-1">
      <Heading class="text-[1.0625rem] leading-snug font-semibold">
        <a href={localePath(locale, `/apps/${app.id}`)} class="sh-stretch">
          {d.name}
        </a>
      </Heading>
      <p class="text-sh-muted truncate text-small">{d.developer}</p>
    </div>
    <span class:list={['sh-pill shrink-0', priceTone]}>{t(locale, `pricing.${d.pricing}`)}</span>
  </div>

  <p class="text-sh-muted line-clamp-2 text-small">{d.summary[locale]}</p>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
    {d.license && <span class="sh-pill">{d.license}</span>}
    <span class="text-sh-muted inline-flex items-center gap-1.5 font-mono text-badge">
      <ShIcon name="monitor" class="size-3.5" />
      {d.platforms.map((p) => t(locale, `platform.${p}`)).join(' · ')}
    </span>
  </div>

  <div class="border-sh-border mt-auto flex flex-col gap-2 border-t border-dashed pt-3">
    <p class="text-sh-muted flex items-center gap-1.5 font-mono text-badge">
      {/* Shape AND colour: a shield with a tick or a question mark, so the
          status never rests on colour alone (WCAG 1.4.1). */}
      <ShIcon
        name={clean ? 'shield-check' : 'shield-question'}
        class={`size-4 shrink-0 ${clean ? 'text-sh-ok' : 'text-sh-warn'}`}
      />
      {security}
    </p>
    <p class="flex flex-wrap gap-x-3 gap-y-1 text-badge">
      {d.categories.map((c) => (
        <a
          href={localePath(locale, `/categories/${c.id}`)}
          class="text-sh-accent relative z-1 font-medium hover:underline"
        >
          {categoryLabels.get(c.id) ?? c.id}
        </a>
      ))}
    </p>
  </div>
</article>

<style>
  /* 326 cards on /apps: let the browser skip layout and paint for the ones
     off screen. The intrinsic size keeps the scrollbar honest meanwhile. */
  .sh-card {
    content-visibility: auto;
    contain-intrinsic-size: auto 15rem;
  }
</style>
