---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
// docs/06 §5 — detail page. Shared by /apps/[slug] and /vi/apps/[slug].
// Hero (logo, name, price, summary) → the official links, Download loudest →
// the facts in a ruled ledger → what the security line means → neighbours
// from the same category.
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShAppCard from '../ShAppCard.astro';
import ShIcon from '../ShIcon.astro';
import ShJsonLd from '../ShJsonLd.astro';
import { compareNames } from '../../lib/filter';
import { logoSvg } from '../../lib/logo';
import { localePath, t, type Locale } from '../../i18n';

interface Props {
  app: CollectionEntry<'apps'>;
  locale: Locale;
}
const { app, locale } = Astro.props;
const d = app.data;

// The schema guarantees min(1) category, but TypeScript cannot see that, and
// docs/10 §1 bans non-null assertions outside tests — so narrow it honestly.
const [primaryRef] = d.categories;
const primary = primaryRef ? await getEntry('categories', primaryRef.id) : undefined;

const RELATED = 4;
const related = primary
  ? (await getCollection('apps'))
      .filter((a) => a.id !== app.id && a.data.categories.some((c) => c.id === primary.id))
      .sort((a, b) => compareNames(a.data.name, b.data.name))
      .slice(0, RELATED)
  : [];

const dateFmt = new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  dateStyle: 'medium',
  timeZone: 'UTC',
});
const fmt = (iso: string) => dateFmt.format(new Date(`${iso}T00:00:00Z`));

const clean = d.security.status === 'clean';
const security = clean
  ? `${t(locale, 'card.security.clean')} · ${t(locale, 'card.checked', { date: fmt(d.security.checkedAt) })}`
  : `${t(locale, 'card.security.unverified')} · ${t(locale, 'card.listed', { date: fmt(d.addedAt) })}`;

const priceTone = {
  free: 'sh-tone-ok',
  'free-onetime': 'sh-tone-accent',
  onetime: 'sh-tone-warn',
}[d.pricing];

interface MetaRow {
  icon: string;
  label: string;
  value: string;
  /** Outbound link for the row. Only the security row uses it, to reach the
   *  scan behind `security.evidence` — hard rule 4 lets us say "no known
   *  warnings as of <date>" and nothing stronger, so the claim is worth much
   *  more when the reader can go and check it. */
  href?: string;
}

const meta: MetaRow[] = [
  { icon: 'user-round', label: t(locale, 'detail.developer'), value: d.developer },
  {
    icon: 'monitor',
    label: t(locale, 'detail.platforms'),
    value: d.platforms.map((p) => t(locale, `platform.${p}`)).join(' · '),
  },
  ...(d.license ? [{ icon: 'scale', label: t(locale, 'detail.license'), value: d.license }] : []),
  ...(d.tags.length
    ? [{ icon: 'tags', label: t(locale, 'detail.tags'), value: d.tags.join(' · ') }]
    : []),
  {
    icon: clean ? 'shield-check' : 'shield-question',
    label: t(locale, 'detail.security'),
    value: security,
    ...(d.security.evidence ? { href: d.security.evidence } : {}),
  },
  { icon: 'calendar-plus', label: t(locale, 'detail.added'), value: fmt(d.addedAt) },
  ...(d.updatedAt
    ? [{ icon: 'calendar-clock', label: t(locale, 'detail.updated'), value: fmt(d.updatedAt) }]
    : []),
];
---

<Base title={`${d.name} — ${t(locale, 'site.name')}`} description={d.summary[locale]} {locale}>
  <ShJsonLd
    {locale}
    site={Astro.site ?? new URL('https://softharbor.net')}
    {app}
    categoryLabelEn={primary?.data.label.en}
  />
  <nav aria-label={t(locale, 'nav.breadcrumb')} class="text-sh-muted text-small">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li>
        <a href={localePath(locale, '/apps')} class="hover:underline">
          {t(locale, 'apps.title')}
        </a>
      </li>
      {primary && (
        <li class="flex items-center gap-1.5">
          <ShIcon name="chevron-right" class="size-3.5" />
          <a href={localePath(locale, `/categories/${primary.id}`)} class="hover:underline">
            {primary.data.label[locale]}
          </a>
        </li>
      )}
      <li class="flex items-center gap-1.5" aria-current="page">
        <ShIcon name="chevron-right" class="size-3.5" />
        <span class="text-sh-ink">{d.name}</span>
      </li>
    </ol>
  </nav>

  {/* No `transition:name` here. Astro generates a per-slug <style> for it and
      does not add that style's hash to the page's own CSP, so the browser
      refused it on every load — see docs/06 §7. */}
  <section class="sh-panel sh-rise mt-5 p-6 md:p-8">
    <div class="flex flex-wrap items-start gap-5">
      <span class="sh-tile size-20">
        <Fragment
          set:html={logoSvg(d.logo, d.name, {
            class: 'size-12',
            'aria-hidden': 'true',
            fill: 'currentColor',
          })}
        />
      </span>
      <div class="min-w-0 flex-1">
        <h1 class="text-[length:var(--text-h1)] font-semibold">{d.name}</h1>
        <p class="text-sh-muted mt-1">{d.developer}</p>
        <p class="mt-3 flex flex-wrap gap-2">
          <span class:list={['sh-pill', priceTone]}>{t(locale, `pricing.${d.pricing}`)}</span>
          {d.license && <span class="sh-pill">{d.license}</span>}
        </p>
      </div>
    </div>

    <p class="mt-6 max-w-3xl text-[length:var(--text-h3)] leading-relaxed">{d.summary[locale]}</p>

    {/* Link rail — Download is the page's one loud element (docs/06 §5). */}
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={d.links.download} rel="noopener" class="sh-btn sh-btn-primary sh-anim">
        <ShIcon name="download" class="size-[18px]" motion="pop" />
        {t(locale, 'detail.download')}
        <ShIcon name="arrow-up-right" class="size-4" motion="nudge-diag" />
      </a>
      <a href={d.links.homepage} rel="noopener" class="sh-btn sh-anim">
        <ShIcon name="globe" class="size-[18px]" motion="pop" />
        {t(locale, 'detail.homepage')}
        <ShIcon name="arrow-up-right" class="size-4" motion="nudge-diag" />
      </a>
      {d.links.repo && (
        <a href={d.links.repo} rel="noopener" class="sh-btn sh-anim">
          <ShIcon name="code-xml" class="size-[18px]" motion="pop" />
          {t(locale, 'detail.repo')}
          <ShIcon name="arrow-up-right" class="size-4" motion="nudge-diag" />
        </a>
      )}
    </div>
    <p class="text-sh-muted mt-4 flex items-center gap-1.5 text-small">
      <ShIcon name="badge-check" class="text-sh-accent size-4 shrink-0" />
      {t(locale, 'detail.officialNote')}
    </p>
  </section>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[1.4fr_1fr]">
    <section class="sh-panel p-6" aria-labelledby="sh-facts">
      <h2 id="sh-facts" class="sh-eyebrow">
        {t(locale, 'detail.facts')}
      </h2>
      <dl class="mt-3">
        {meta.map((row) => (
          <div class="sh-fact">
            <dt class="text-sh-muted flex items-center gap-2">
              <ShIcon name={row.icon} class="size-4 shrink-0" />
              {row.label}
            </dt>
            <dd class="font-mono text-small">
              {row.value}
              {row.href && (
                <>
                  {' · '}
                  <a
                    href={row.href}
                    rel="noopener"
                    class="sh-anim text-sh-accent inline-flex items-center gap-0.5 underline"
                  >
                    {t(locale, 'detail.evidence')}
                    <ShIcon name="arrow-up-right" class="size-3.5" motion="nudge-diag" />
                  </a>
                </>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <aside
      class:list={[
        'sh-panel p-6',
        clean ? 'bg-sh-ok-soft border-transparent' : 'bg-sh-warn-soft border-transparent',
      ]}
      aria-labelledby="sh-status"
    >
      <h2 id="sh-status" class="flex items-center gap-2 font-semibold">
        <ShIcon
          name={clean ? 'shield-check' : 'shield-question'}
          class={`size-5 ${clean ? 'text-sh-ok' : 'text-sh-warn'}`}
        />
        {t(locale, 'detail.securityNote.title')}
      </h2>
      <p class="mt-3 text-small leading-relaxed">
        {t(locale, clean ? 'detail.securityNote.clean' : 'detail.securityNote.unverified')}
      </p>
      <a
        href={localePath(locale, '/legal/disclaimer')}
        class="sh-anim mt-4 inline-flex items-center gap-1 text-small font-medium underline"
      >
        {t(locale, 'detail.disclaimerLink')}
        <ShIcon name="arrow-right" class="size-4" motion="nudge-x" />
      </a>
    </aside>
  </div>

  {primary && related.length > 0 && (
    <section class="mt-14" aria-labelledby="sh-related">
      <h2 id="sh-related" class="text-[length:var(--text-h2)] font-semibold">
        {t(locale, 'detail.related', { category: primary.data.label[locale] })}
      </h2>
      <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((r) => (
          <ShAppCard app={r} {locale} headingLevel={3} />
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .sh-fact {
    display: grid;
    grid-template-columns: minmax(8rem, 11rem) 1fr;
    gap: 0.25rem 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px dashed var(--sh-border);
  }
  .sh-fact:last-child {
    border-bottom: 0;
  }
  @media (width < 30rem) {
    .sh-fact {
      grid-template-columns: 1fr;
    }
  }
</style>
