// docs/06 §5 — SEO landing per category: h1 = label, count, pre-filtered grid.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShAppCard from '../ShAppCard.astro';
import { byAddedDesc } from '../../lib/paths';
import ShIcon from '../ShIcon.astro';
import { appCount, localePath, t, type Locale } from '../../i18n';

interface Props {
  category: CollectionEntry<'categories'>;
  locale: Locale;
}
const { category, locale } = Astro.props;

const apps = (await getCollection('apps'))
  .filter((a) => a.data.categories.some((c) => c.id === category.id))
  .sort(byAddedDesc);

const label = category.data.label[locale];
const count = new Intl.NumberFormat(locale === 'vi' ? 'vi-VN' : 'en-GB').format(apps.length);
---

<Base
  title={`${label} — ${t(locale, 'site.name')}`}
  description={t(locale, 'meta.category', { n: count, label })}
  {locale}
>
  <nav aria-label={t(locale, 'nav.breadcrumb')} class="text-sh-muted text-small">
    <a
      href={localePath(locale, '/categories')}
      class="sh-anim inline-flex items-center gap-1 hover:underline"
    >
      <ShIcon name="arrow-left" class="size-4" />
      {t(locale, 'categories.title')}
    </a>
  </nav>

  <div class="mt-5 flex items-center gap-4">
    <span class="sh-tile bg-sh-accent-soft text-sh-accent size-14 border-transparent">
      <ShIcon name={category.data.icon} class="size-7" />
    </span>
    <div>
      <h1 class="text-[length:var(--text-h1)] font-semibold">{label}</h1>
      <p class="sh-eyebrow mt-1 normal-case tracking-normal">{appCount(locale, apps.length)}</p>
    </div>
  </div>

  {apps.length === 0 ? (
    <p class="sh-panel text-sh-muted mt-8 p-6">{t(locale, 'categories.empty')}</p>
  ) : (
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {apps.map((app) => (
        <ShAppCard {app} {locale} />
      ))}
    </div>
  )}
</Base>
