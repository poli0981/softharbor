// Category index. The header has always linked here (docs/06 §4); until M2 the
// link 404'd.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { iconSvg } from '../../lib/icon';
import { localePath, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const apps = await getCollection('apps');
const countFor = (id: string) =>
  apps.filter((a) => a.data.categories.some((c) => c.id === id)).length;
---

<Base title={`${t(locale, 'categories.title')} — ${t(locale, 'site.name')}`} {locale}>
  <h1 class="text-[length:var(--text-h1)] font-semibold">{t(locale, 'categories.title')}</h1>
  <p class="mt-2 max-w-2xl" style="color: var(--sh-muted)">{t(locale, 'categories.intro')}</p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      categories.map((c) => (
        <li class="sh-panel sh-lift relative p-5">
          <div class="flex items-center gap-3">
            <Fragment
              set:html={iconSvg(`lucide:${c.data.icon}`, {
                class: 'size-6 shrink-0',
                'aria-hidden': 'true',
              })}
            />
            <h2 class="text-[length:var(--text-h3)] font-semibold">
              <a href={localePath(locale, `/categories/${c.id}`)} class="sh-stretch">
                {c.data.label[locale]}
              </a>
            </h2>
          </div>
          <p class="mt-2 font-mono text-[var(--text-badge)]" style="color: var(--sh-muted)">
            {t(locale, 'apps.count', { n: countFor(c.id) })}
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .sh-stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
