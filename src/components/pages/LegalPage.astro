---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
//
// docs/14 — shared chrome for the five legal documents. Prose lives per
// locale in src/components/legal/, not in the i18n dictionaries: docs/07 §1
// puts legal in its own layer precisely because multi-paragraph documents are
// content, not UI strings, and the English text is canonical (docs/07 §8).
//
// These routes are EXEMPT from the legal gate (docs/14 Part 2) — the gate
// links here, so gating them would dead-lock acceptance.
import Base from '../../layouts/Base.astro';
import { LEGAL_VERSION } from '../../lib/legal';
import { t, type Locale } from '../../i18n';

interface Props {
  title: string;
  locale: Locale;
}
const { title, locale } = Astro.props;

const updated = new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  dateStyle: 'medium',
  timeZone: 'UTC',
}).format(new Date(`${LEGAL_VERSION}T00:00:00Z`));
---

{
  /* Suffixed like every other page: an unbranded <title> in a SERP reads as
    someone else's document. The description names the document too, so the
    six legal pages are not six copies of the site tagline. */
}
<Base
  title={`${title} — ${t(locale, 'site.name')}`}
  description={t(locale, 'meta.legal', { title })}
  {locale}
>
  <article class="sh-prose max-w-2xl">
    <h1 class="text-[length:var(--text-h1)] font-semibold">{title}</h1>

    <p class="text-sh-muted mt-2 font-mono text-[var(--text-badge)]">
      {t(locale, 'legal.lastUpdated', { date: updated })}
    </p>

    {
      locale === 'vi' && (
        <p class="sh-panel text-sh-muted mt-6 p-4 text-[var(--text-small)]" lang="vi">
          {/* Fixed notice required on every VI legal page (docs/07 §8). */}
          {t('vi', 'legal.viNotice')}
        </p>
      )
    }

    {
      /* No inter-document nav here: ShFooter already lists all of them on
        every page, and repeating the same six links a screen apart is just
        noise. */
    }
    <div class="mt-8 flex flex-col gap-4"><slot /></div>
  </article>
</Base>

<style is:global>
  /* Legal prose is the one place on the site with real running text. */
  .sh-prose h2 {
    font-size: var(--text-h3);
    font-weight: 600;
    margin-top: 1.5rem;
  }
  .sh-prose p {
    max-width: 65ch;
  }
  .sh-prose strong {
    font-weight: 700;
  }
  .sh-prose a {
    color: var(--sh-accent);
    text-decoration: underline;
  }
  .sh-prose ol {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    counter-reset: item;
  }
  .sh-prose ol > li {
    max-width: 65ch;
  }
</style>
