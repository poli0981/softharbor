---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
//
// docs/06 §5, docs/08 Part C — shared shell for 404/offline/errors.
//
// Bilingual on ONE page rather than per-locale: an error can be reached from
// either locale (and /offline is reached with no network at all), so there is
// no safe moment to pick one. Copy lives in the dictionaries (error.<kind>.*)
// like every other UI string, so i18n:check covers it.
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';

type Kind = '404' | 'offline' | '403' | '429' | '500';

interface Props {
  kind: Kind;
  /**
   * Default true for every error shell. 404 used to opt out on the grounds that
   * its status code excludes it from SERPs — but /404 requested directly is
   * served with 200, so it needs the tag like the others.
   */
  noindex?: boolean;
}
const { kind, noindex = true } = Astro.props;
---

<Base
  title={`${t('en', `error.${kind}.title`)} — SoftHarbor`}
  locale="en"
  {noindex}
  gateExempt
  alternates={false}
>
  <div class="relative">
    {/* Giant clipped status code at 40% opacity, behind the text (docs/06 §5). */}
    <span
      aria-hidden="true"
      class="text-sh-muted pointer-events-none absolute -top-10 -left-2 font-mono text-[8rem] leading-none opacity-40 select-none"
    >
      {kind}
    </span>
    <div class="relative">
      <h1 class="text-[length:var(--text-h1)] font-semibold">{t('en', `error.${kind}.title`)}</h1>
      <p class="text-sh-muted mt-3 max-w-xl">{t('en', `error.${kind}.body`)}</p>

      <h2 class="mt-8 text-[length:var(--text-h3)] font-semibold" lang="vi">
        {t('vi', `error.${kind}.title`)}
      </h2>
      <p class="text-sh-muted mt-2 max-w-xl" lang="vi">
        {t('vi', `error.${kind}.body`)}
      </p>

      <p class="mt-8 flex flex-wrap gap-4">
        <a href="/" class="text-sh-accent underline">
          {t('en', 'error.home')}
        </a>
        <a href="/apps" class="text-sh-accent underline">
          {t('en', 'nav.apps')}
        </a>
        <a href="/vi" class="text-sh-accent underline" lang="vi">
          {t('vi', 'error.home')}
        </a>
      </p>
    </div>
  </div>
</Base>
