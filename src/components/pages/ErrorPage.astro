---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
//
// docs/06 §5, docs/08 Part C — shared shell for 404/offline/errors.
//
// Bilingual on ONE page rather than per-locale: an error can be reached from
// either locale (and /offline is reached with no network at all), so there is
// no safe moment to pick one.
import Base from '../../layouts/Base.astro';

interface Props {
  code: string;
  titleEn: string;
  titleVi: string;
  bodyEn: string;
  bodyVi: string;
  /** 404 needs none — its status code already excludes it (docs/16 §7). */
  noindex?: boolean;
}
const { code, titleEn, titleVi, bodyEn, bodyVi, noindex = true } = Astro.props;
---

<Base title={`${titleEn} — SoftHarbor`} locale="en" {noindex}>
  <div class="relative">
    {/* Giant clipped status code at 40% opacity, behind the text (docs/06 §5). */}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-10 -left-2 font-mono text-[8rem] leading-none opacity-40 select-none"
      style="color: var(--sh-muted)">{code}</span
    >
    <div class="relative">
      <h1 class="text-[length:var(--text-h1)] font-semibold">{titleEn}</h1>
      <p class="mt-3 max-w-xl" style="color: var(--sh-muted)">{bodyEn}</p>

      <h2 class="mt-8 text-[length:var(--text-h3)] font-semibold" lang="vi">{titleVi}</h2>
      <p class="mt-2 max-w-xl" lang="vi" style="color: var(--sh-muted)">{bodyVi}</p>

      <p class="mt-8 flex flex-wrap gap-4">
        <a href="/" class="underline" style="color: var(--sh-accent)">SoftHarbor</a>
        <a href="/apps" class="underline" style="color: var(--sh-accent)">Apps</a>
      </p>
    </div>
  </div>
</Base>
