---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
//
// docs/06 §5, docs/08 Part C — shared shell for 404/offline/errors.
//
// Bilingual on ONE page rather than per-locale: an error can be reached from
// either locale (and /offline is reached with no network at all), so there is
// no safe moment to pick one. Copy lives in the dictionaries (error.<kind>.*)
// like every other UI string, so i18n:check covers it.
import Base from '../../layouts/Base.astro';
import ShIcon from '../ShIcon.astro';
import { t } from '../../i18n';

type Kind = '404' | 'offline' | '403' | '429' | '500';

interface Props {
  kind: Kind;
  /**
   * Default true for every error shell. 404 used to opt out on the grounds that
   * its status code excludes it from SERPs — but /404 requested directly is
   * served with 200, so it needs the tag like the others.
   */
  noindex?: boolean;
}
const { kind, noindex = true } = Astro.props;

const ICON: Record<Kind, string> = {
  '404': 'map-pinned',
  offline: 'wifi-off',
  '403': 'lock',
  '429': 'hourglass',
  '500': 'life-buoy',
};
---

<Base
  title={`${t('en', `error.${kind}.title`)} — SoftHarbor`}
  locale="en"
  {noindex}
  gateExempt
  alternates={false}
>
  <section class="sh-contours py-6 md:py-14">
    {/* The status code, set large in the ledger's mono and fading behind the
        text (docs/06 §5) — decoration, so hidden from assistive tech. */}
    <p
      aria-hidden="true"
      class="text-sh-accent pointer-events-none font-mono text-[clamp(5rem,18vw,10rem)] leading-none font-medium tracking-tight opacity-25 select-none"
    >
      {kind === 'offline' ? '···' : kind}
    </p>

    <div class="mt-2 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2">
      <div class="sh-panel p-6">
        <span class="sh-tile bg-sh-accent-soft text-sh-accent size-11 border-transparent">
          <ShIcon name={ICON[kind]} class="size-[22px]" />
        </span>
        <h1 class="mt-4 text-[length:var(--text-h2)] font-semibold">
          {t('en', `error.${kind}.title`)}
        </h1>
        <p class="text-sh-muted mt-2">{t('en', `error.${kind}.body`)}</p>
      </div>
      <div class="sh-panel p-6" lang="vi">
        <span class="sh-tile bg-sh-accent-soft text-sh-accent size-11 border-transparent">
          <ShIcon name={ICON[kind]} class="size-[22px]" />
        </span>
        <h2 class="mt-4 text-[length:var(--text-h2)] font-semibold">
          {t('vi', `error.${kind}.title`)}
        </h2>
        <p class="text-sh-muted mt-2">{t('vi', `error.${kind}.body`)}</p>
      </div>
    </div>

    <p class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="sh-btn sh-btn-primary sh-anim">
        <ShIcon name="anchor" class="size-[18px]" motion="pop" />
        {t('en', 'error.home')}
      </a>
      <a href="/apps" class="sh-btn sh-anim">
        <ShIcon name="layout-grid" class="size-[18px]" motion="pop" />
        {t('en', 'nav.apps')}
      </a>
      <a href="/vi" class="sh-btn sh-anim" lang="vi">
        <ShIcon name="languages" class="size-[18px]" motion="pop" />
        {t('vi', 'error.home')}
      </a>
    </p>
  </section>
</Base>
