---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
// docs/06 §4 — footer: the site in one line, then four short columns —
// browse, open data, legal, project.
import ShIcon from './ShIcon.astro';
import ShBugReport from './islands/ShBugReport.svelte';
import { localePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const REPO = 'https://github.com/poli0981/softharbor';

const legal = [
  ['/legal/disclaimer', 'footer.legal.disclaimer'],
  ['/legal/privacy', 'footer.legal.privacy'],
  ['/legal/terms', 'footer.legal.terms'],
  ['/legal/trademarks', 'footer.legal.trademarks'],
  ['/legal/third-party', 'footer.legal.thirdParty'],
  ['/legal/ai-disclosure', 'footer.legal.aiDisclosure'],
] as const;

// Build date, not request date — this is a static site, so it is the honest
// "as of" for everything on the page.
const built = new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  dateStyle: 'medium',
  timeZone: 'UTC',
}).format(new Date());
---

<footer class="border-sh-border bg-sh-surface mt-24 border-t">
  <div class="mx-auto grid max-w-[1360px] grid-cols-2 gap-10 px-4 py-12 md:grid-cols-[1.4fr_repeat(4,1fr)] md:px-6">
    <div class="col-span-2 flex flex-col gap-3 md:col-span-1">
      <a href={localePath(locale, '/')} class="sh-anim flex w-fit items-center gap-2.5">
        <span class="sh-tile bg-sh-accent text-sh-accent-ink size-8 border-transparent">
          <ShIcon name="anchor" class="size-[18px]" motion="pop" />
        </span>
        <span class="font-display text-[1.1875rem] font-semibold">{t(locale, 'site.name')}</span>
      </a>
      <p class="text-sh-muted max-w-xs text-small">{t(locale, 'site.tagline')}</p>
      <p class="sh-eyebrow mt-auto">{t(locale, 'footer.license')}</p>
      <p class="sh-eyebrow">{t(locale, 'footer.builtAt', { date: built })}</p>
    </div>

    <nav aria-labelledby="sh-foot-browse" class="sh-foot">
      <h2 id="sh-foot-browse" class="sh-eyebrow">
        {t(locale, 'footer.browse')}
      </h2>
      <a href={localePath(locale, '/apps')}>{t(locale, 'nav.apps')}</a>
      <a href={localePath(locale, '/categories')}>{t(locale, 'nav.categories')}</a>
      <a href={`${localePath(locale, '/apps')}#search`}>{t(locale, 'search.label')}</a>
    </nav>

    <nav aria-labelledby="sh-foot-data" class="sh-foot">
      <h2 id="sh-foot-data" class="sh-eyebrow">
        {t(locale, 'footer.data')}
      </h2>
      <a href="/api/apps.json" class="sh-anim">
        <ShIcon name="braces" class="size-4" motion="pop" />
        {t(locale, 'footer.api')}
      </a>
      <a href="/rss.xml" class="sh-anim">
        <ShIcon name="rss" class="size-4" motion="pop" />
        {t(locale, 'footer.rss')}
      </a>
      <a href={`${REPO}/blob/main/LICENSE-DATA.md`} rel="noopener">
        CC BY-SA 4.0
      </a>
    </nav>

    <nav aria-labelledby="sh-foot-legal" class="sh-foot">
      <h2 id="sh-foot-legal" class="sh-eyebrow">
        {t(locale, 'footer.legal.heading')}
      </h2>
      {legal.map(([path, key]) => (
        <a href={localePath(locale, path)}>{t(locale, key)}</a>
      ))}
    </nav>

    <nav aria-labelledby="sh-foot-project" class="sh-foot">
      <h2 id="sh-foot-project" class="sh-eyebrow">
        {t(locale, 'footer.project')}
      </h2>
      <a href={localePath(locale, '/contact')}>{t(locale, 'footer.contact')}</a>
      <a href={REPO} rel="noopener" class="sh-anim">
        {t(locale, 'footer.github')}
        <ShIcon name="arrow-up-right" class="size-3.5" motion="nudge-diag" />
      </a>
      <a href={`${REPO}/releases`} rel="noopener" class="sh-anim">
        {t(locale, 'footer.releases')}
        <ShIcon name="arrow-up-right" class="size-3.5" motion="nudge-diag" />
      </a>
      {/* client:visible — it lives at the bottom and nothing depends on it
          until seen. The ring buffer it reads is filled by errors.js, which
          loads first, so scrolling late does not lose errors (docs/05 §A5). */}
      <ShBugReport
        client:visible
        label={t(locale, 'bug.report')}
        countLabel={t(locale, 'bug.errorCount')}
      />
    </nav>
  </div>
</footer>

<style>
  .sh-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: var(--text-small);
  }
  .sh-foot h2 {
    font-family: var(--font-mono);
    margin-bottom: 0.25rem;
  }
  .sh-foot :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sh-ink);
    text-decoration: none;
    text-underline-offset: 0.2em;
  }
  .sh-foot :global(a:hover) {
    color: var(--sh-accent);
    text-decoration: underline;
  }
</style>
