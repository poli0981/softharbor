---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
// docs/06 §4 — footer. ShBugReport lands in M5 (docs/02 §5).
import ShBugReport from './islands/ShBugReport.svelte';
import { localePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const legal = [
  ['/legal/disclaimer', 'footer.legal.disclaimer'],
  ['/legal/privacy', 'footer.legal.privacy'],
  ['/legal/terms', 'footer.legal.terms'],
  ['/legal/trademarks', 'footer.legal.trademarks'],
  ['/legal/third-party', 'footer.legal.thirdParty'],
  ['/legal/ai-disclosure', 'footer.legal.aiDisclosure'],
] as const;

// Build date, not request date — this is a static site, so it is the honest
// "as of" for everything on the page.
const built = new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  dateStyle: 'medium',
  timeZone: 'UTC',
}).format(new Date());
---

<footer class="border-sh-border mt-16 border-t-2">
  <div
    class="mx-auto flex max-w-[1360px] flex-col gap-4 px-4 py-8 md:flex-row md:justify-between md:px-6"
  >
    <nav aria-label={t(locale, 'footer.legal.heading')} class="flex flex-wrap gap-x-4 gap-y-2">
      {
        legal.map(([path, key]) => (
          <a href={localePath(locale, path)} class="hover:underline">
            {t(locale, key)}
          </a>
        ))
      }
    </nav>

    <div class="text-sh-muted flex flex-col gap-1 md:items-end">
      <span class="font-mono text-[var(--text-badge)]">{t(locale, 'footer.license')}</span>
      <a
        href="https://github.com/poli0981/softharbor"
        rel="noopener"
        class="font-mono text-[var(--text-badge)] hover:underline"
      >
        {t(locale, 'footer.github')}
      </a>
      {
        /* client:visible — it lives at the bottom and nothing depends on it
          until seen. The ring buffer it reads is filled from /errors.js, which
          loads early, so scrolling late does not lose errors (docs/05 §A5). */
      }
      <span class="font-mono text-[var(--text-badge)]">
        <ShBugReport
          client:visible
          label={t(locale, 'bug.report')}
          countLabel={t(locale, 'bug.errorCount')}
        />
      </span>
      <span class="font-mono text-[var(--text-badge)]">
        {t(locale, 'footer.builtAt', { date: built })}
      </span>
    </div>
  </div>
</footer>
