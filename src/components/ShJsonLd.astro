//
// docs/16 §7 — structured data.
//
// A <script type="application/ld+json"> is a DATA block, not executable
// script, so the strict CSP needs no hash for it (docs/09 §4) — confirmed in
// the S1 build.
import type { CollectionEntry } from 'astro:content';
import { localePath, t, type Locale } from '../i18n';

// `| undefined` is explicit because tsconfig sets exactOptionalPropertyTypes
// (docs/10 §1): there, `foo?: string` means "absent or string", NOT "may be
// passed as undefined" — and these are passed from optional lookups.
interface Props {
  locale: Locale;
  site: URL;
  app?: CollectionEntry<'apps'> | undefined;
  categoryLabelEn?: string | undefined;
  /** Rendered on the welcome page only. */
  website?: boolean | undefined;
}
const { locale, site, app, categoryLabelEn, website = false } = Astro.props;

const abs = (path: string) => new URL(path, site).href;

const nodes: Record<string, unknown>[] = [];

if (website) {
  // One WebSite node, on / only. No SearchAction in v1: search is client-side
  // with no ?q= deep link to point at (docs/16 §7, docs/15 §2).
  nodes.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t(locale, 'site.name'),
    url: abs(localePath(locale, '/')),
    inLanguage: locale === 'vi' ? 'vi-VN' : 'en-GB',
  });
}

if (app) {
  const d = app.data;
  nodes.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: d.name,
    description: d.summary[locale],
    operatingSystem: d.platforms
      .map((p) => ({ windows: 'Windows', macos: 'macOS', linux: 'Linux' })[p])
      .join(', '),
    applicationCategory: categoryLabelEn,
    url: abs(localePath(locale, `/apps/${app.id}`)),
    author: { '@type': 'Organization', name: d.developer },
    sameAs: [d.links.homepage, d.links.repo].filter(Boolean),
    // Price is stated ONLY for `free`. We do not know the amount for onetime
    // entries and will not invent one — truthfulness over rich-result greed
    // (docs/16 §7, hard rule 4's spirit).
    ...(d.pricing === 'free'
      ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }
      : {}),
  });

  nodes.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t(locale, 'site.name'),
        item: abs(localePath(locale, '/')),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(locale, 'nav.apps'),
        item: abs(localePath(locale, '/apps')),
      },
      { '@type': 'ListItem', position: 3, name: d.name },
    ],
  });
}
---

{/* `<` is escaped as \u003c: JSON.stringify leaves it alone, so a name or
    summary containing `</script>` would end the data block early and inject
    markup. CSP would stop an injected script, but not an injected link. */}
{nodes.map((node) => (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(node).replace(/</g, '\\u003c')}
  />
))}
