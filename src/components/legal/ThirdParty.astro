---
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 poli0981 (SkullMute)
// docs/14 §3e. The Simple Icons caveat is shown verbatim, as the doc requires.
// The package table is generated at build time (src/lib/licenses.ts), so it
// lists what this build was actually made from.
import { CONTACTS } from '../../lib/contacts';
import { productionLicenses } from '../../lib/licenses';
import type { Locale } from '../../i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const en = locale === 'en';
const COPYRIGHT = CONTACTS.copyright;
const privacy = en ? '/legal/privacy' : '/vi/legal/privacy';

const rows = [
  {
    component: 'Astro, Svelte, Tailwind CSS, MiniSearch, nanostores, Workbox (via @vite-pwa)',
    license: 'MIT',
    note: { en: 'build/runtime', vi: 'dựng/chạy' },
  },
  {
    component: 'Lucide icons',
    license: 'ISC',
    note: { en: 'UI icons', vi: 'biểu tượng giao diện' },
  },
  {
    component: 'Simple Icons',
    license: 'CC0-1.0',
    note: {
      en: 'The icons are CC0, but the brands they depict remain trademarks of their owners; see /legal/trademarks',
      vi: 'Bộ biểu tượng theo CC0, nhưng các thương hiệu được mô tả vẫn là nhãn hiệu của chủ sở hữu; xem /legal/trademarks',
    },
  },
  {
    component: 'Bricolage Grotesque · Be Vietnam Pro · IBM Plex Mono',
    license: 'SIL OFL 1.1',
    note: { en: 'self-hosted via Fontsource', vi: 'tự lưu trữ qua Fontsource' },
  },
];

/** Services that receive requests while you use the site (see the Privacy Policy). */
const services = [
  {
    name: 'Cloudflare',
    what: {
      en: 'Hosting and delivery (Workers, Static Assets), the /api/verify endpoint, Web Analytics, and Turnstile.',
      vi: 'Lưu trữ và phân phối (Workers, Static Assets), điểm /api/verify, Web Analytics và Turnstile.',
    },
    policy: 'https://www.cloudflare.com/privacypolicy/',
  },
  {
    name: 'GitHub',
    what: {
      en: 'The source repository, issues, and the prefilled "Report a bug" form.',
      vi: 'Kho mã nguồn, issue và biểu mẫu "Báo lỗi" được điền sẵn.',
    },
    policy:
      'https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement',
  },
];

const packages = productionLicenses();
---

<p>
  {en
    ? 'SoftHarbor is built with open-source software. Runtime and asset dependencies and their licenses:'
    : 'SoftHarbor được xây dựng trên phần mềm mã nguồn mở. Các thành phần và giấy phép tương ứng:'}
</p>

<div class="-mx-4 overflow-x-auto px-4">
  <table class="w-full border-collapse text-small">
    <thead>
      <tr class="border-sh-border border-b-2 text-left">
        <th class="py-2 pr-4">{en ? 'Component' : 'Thành phần'}</th>
        <th class="py-2 pr-4">{en ? 'License' : 'Giấy phép'}</th>
        <th class="py-2">{en ? 'Note' : 'Ghi chú'}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class="border-sh-border border-b opacity-95">
          <td class="py-2 pr-4 align-top">{r.component}</td>
          <td class="py-2 pr-4 align-top font-mono whitespace-nowrap">{r.license}</td>
          <td class="text-sh-muted py-2 align-top">{r.note[locale]}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<h2 id="services">{en ? 'Services' : 'Dịch vụ'}</h2>
<p>
  {en
    ? 'These services receive requests while you use the site. What each one sees is set out in the '
    : 'Các dịch vụ sau nhận yêu cầu khi bạn dùng trang. Mỗi dịch vụ thấy những gì được nêu trong '}
  <a href={privacy}>{en ? 'Privacy Policy' : 'Chính sách quyền riêng tư'}</a>.
</p>
<ul>
  {services.map((s) => (
    <li>
      <strong>{s.name}</strong> — {s.what[locale]}{' '}
      <a href={s.policy}>{en ? 'Its privacy policy' : 'Chính sách quyền riêng tư của họ'}</a>.
    </li>
  ))}
</ul>

<h2 id="packages">{en ? 'Every package in this build' : 'Mọi gói trong bản dựng này'}</h2>
<p class="text-sh-muted">
  {en
    ? 'Generated when the site is built, from package.json and the installed packages, so it always matches the code you are looking at.'
    : 'Được tạo tự động mỗi lần dựng trang, từ package.json và các gói đã cài, nên luôn khớp với mã nguồn bạn đang xem.'}
</p>
<div class="-mx-4 overflow-x-auto px-4">
  <table class="w-full border-collapse text-small">
    <thead>
      <tr class="border-sh-border border-b-2 text-left">
        <th class="py-2 pr-4">{en ? 'Package' : 'Gói'}</th>
        <th class="py-2 pr-4">{en ? 'Version' : 'Phiên bản'}</th>
        <th class="py-2">{en ? 'License' : 'Giấy phép'}</th>
      </tr>
    </thead>
    <tbody>
      {packages.map((p) => (
        <tr class="border-sh-border border-b opacity-95">
          <td class="py-2 pr-4 align-top font-mono">{p.name}</td>
          <td class="py-2 pr-4 align-top font-mono">{p.version}</td>
          <td class="py-2 align-top font-mono whitespace-nowrap">{p.license}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p class="text-sh-muted">
  {en ? 'Questions about licensing: ' : 'Câu hỏi về giấy phép: '}
  <a href={`mailto:${COPYRIGHT}`}>{COPYRIGHT}</a>.
</p>
