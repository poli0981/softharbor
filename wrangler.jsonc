{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softharbor",
  "compatibility_date": "2026-07-15",
  // No "main" — pure static assets, requests are unbilled. Adding one flips
  // billing and the error model: decision-log entry required (docs/02 §7).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page", // serves dist/404.html with HTTP 404
    // Pairs with astro's trailingSlash:'never' + build.format:'file'.
    // Measured in S1 on a real deploy: "auto-trailing-slash" 307s /apps to
    // /apps/, which contradicts every canonical, sitemap entry and hreflang
    // alternate we emit. "drop-trailing-slash" makes the no-slash URL the one
    // that serves 200 and redirects the slashed variant to it.
    "html_handling": "drop-trailing-slash",
  },
  // No `routes` here — on purpose since commit 66c6255 (2026-07-28).
  //
  // softharbor.net and www.softharbor.net are attached as Custom Domains in
  // the Cloudflare dashboard (Workers & Pages → softharbor → Domains). With no
  // `routes` key, `wrangler deploy` leaves those triggers untouched; declaring
  // them here is what previously let a deploy reconcile the hand-added `www`
  // record away (observed 2026-07-28). Re-creating the Worker from a fresh
  // clone therefore needs the two domains re-attached by hand (docs/16 §3).
  //
  // www never SERVES the site: the zone Redirect Rule (docs/16 §4 R1) runs
  // before Workers and 301s it to the apex. That rule is a hard prerequisite —
  // without it www would serve a duplicate of the site, which is the exact
  // hazard docs/16 N1/N2 exist to prevent. Verified after every deploy in the
  // launch checklist (docs/13 §2).

  "workers_dev": false, // canonical origin is the custom domain only
  // PR builds upload preview versions to *.workers.dev; public/_headers marks
  // that host pattern `X-Robots-Tag: noindex`.
  "preview_urls": true,
}
