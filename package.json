{
  "name": "softharbor",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Bilingual (EN/VI) directory of free and buy-once desktop software",
  "license": "GPL-3.0-only",
  "author": "poli0981 / SkullMute",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=26 <27"
  },
  "//": "Dependency build-script policy lives in pnpm-workspace.yaml (allowBuilds) — pnpm 11 ignores a \"pnpm\" field here.",
  "scripts": {
    "build": "pnpm run validate:data && pnpm run i18n:check && astro build && pnpm run postbuild:html && pnpm run check:csp && pnpm run check:assets && pnpm run check:sw && pnpm run check:feed",
    "build:site": "astro build",
    "check": "astro check && tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:feed": "node scripts/check-feed.mjs",
    "check:sw": "node scripts/check-service-worker.mjs",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "astro dev",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "knip": "knip",
    "lint": "eslint . && prettier --check .",
    "postbuild:html": "node scripts/postbuild.mjs",
    "preview": "astro preview",
    "quarantine": "node scripts/quarantine.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "node scripts/validate-data.mjs",
    "vt:recheck": "node scripts/vt-recheck.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.4.2",
    "minisearch": "^7.2.0",
    "nanostores": "^1.5.5",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "unplugin-icons": "^24.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
