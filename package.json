{
  "name": "softharbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bilingual (EN/VI) directory of free and buy-once desktop software",
  "license": "GPL-3.0-only",
  "author": "poli0981 / SkullMute",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "//": "Dependency build-script policy lives in pnpm-workspace.yaml (allowBuilds) — pnpm 11 ignores a \"pnpm\" field here.",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "check:styles": "node scripts/check-no-inline-styles.mjs",
    "check:sw": "node scripts/check-service-worker.mjs",
    "coverage": "vitest run --coverage",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "format": "prettier --write .",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "knip": "knip",
    "lint": "eslint . && prettier --check .",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "node scripts/validate-data.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.1.3",
    "minisearch": "^7.2.0",
    "nanostores": "^1.4.1",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3",
    "unplugin-icons": "^23.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
